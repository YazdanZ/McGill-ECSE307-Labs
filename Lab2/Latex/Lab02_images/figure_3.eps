0 0 M
560 0 L
560 420 L
0 420 L
0 0 L
cp
clip
GS
0 0 translate
560 420 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 420
  /ImageMatrix [560 0 0 420 0 0]
  /Width 560
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
